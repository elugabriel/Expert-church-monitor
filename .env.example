# Copy this file to .env for local development (python-dotenv will load it).

# Random long string used to sign sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local SQLite (default, good for quick testing):
DATABASE_URL=sqlitecloud://chil78csdz.g2.sqlite.cloud:8860/auth.sqlitecloud?apikey=rbUirAXbC3pN0lFK67BlUnZ1RpcPS1Zpb5FQxX74AHE

# SQLite Cloud (for shared/testing environments), format:
#   sqlitecloud://<host>.sqlite.cloud:8860/<dbname>.sqlite?apikey=<your-api-key>
# DATABASE_URL=sqlitecloud://myhost.sqlite.cloud:8860/church.sqlite?apikey=your-api-key

# First-run super admin credentials (printed to the console if left unset).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=E8eeDBQUZllp

# Outgoing email for absentee follow-ups (Reports -> Absentee Report).
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourchurch@gmail.com
MAIL_PASSWORD=your-16-char-app-password
